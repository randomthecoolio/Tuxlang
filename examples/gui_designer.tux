import gui

local app = gui.newApp()
local win = gui.newWindow(app, "Tux Designer")

gui.setWindowSize(win, 760, 520)
gui.setWindowPosition(win, 120, 80)
gui.setBackground(win, "#f4efe6")

local title = gui.newLabel("Build native-looking tools in Tux")
gui.setPosition(title, 24, 20)
gui.setSize(title, 420, 36)
gui.setFontSize(title, 16)
gui.setColors(title, "#102033", "#f4efe6")

local panel = gui.newPanel()
gui.setPosition(panel, 24, 72)
gui.setSize(panel, 700, 320)
gui.setBackground(panel, "#fffaf2")

local nameLabel = gui.newLabel("Project name")
gui.setPosition(nameLabel, 18, 18)
gui.setSize(nameLabel, 180, 24)
gui.setColors(nameLabel, "#243447", "#fffaf2")

local nameInput = gui.newTextInput("Tux Studio")
gui.setID(nameInput, "project")
gui.setPosition(nameInput, 18, 46)
gui.setSize(nameInput, 280, 32)

local themeLabel = gui.newLabel("Accent color")
gui.setPosition(themeLabel, 18, 96)
gui.setSize(themeLabel, 180, 24)
gui.setColors(themeLabel, "#243447", "#fffaf2")

local themeInput = gui.newTextInput("#0f766e")
gui.setID(themeInput, "accent")
gui.setPosition(themeInput, 18, 124)
gui.setSize(themeInput, 180, 32)

local action = gui.newButton("Create Window")
gui.setID(action, "create")
gui.setPosition(action, 18, 190)
gui.setSize(action, 160, 42)
gui.setColors(action, "#ffffff", "#0f766e")

gui.add(panel, nameLabel)
gui.add(panel, nameInput)
gui.add(panel, themeLabel)
gui.add(panel, themeInput)
gui.add(panel, action)

gui.add(win, title)
gui.add(win, panel)

local result = gui.showAndRun(app)
print("action:", result["action"])
print("target:", result["target"])
print("project:", result["values"]["project"])
print("accent:", result["values"]["accent"])
