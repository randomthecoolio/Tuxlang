import io

class User
    function init(name)
        this.name = name
    end

    function greet()
        return "hi " + this.name
    end
end

class Admin extends User
    function greet()
        return "admin " + this.name
    end
end

local u = new User("tux")
local a = new Admin("root")

io.print(u.greet())
io.print(a.greet())

u.name = "penguin"
io.print(u.greet())
