import gui

local app = gui.newApp()
local win = gui.newWindow(app, "Calculator")
gui.setWindowSize(win, 290, 320)

local display = gui.newTextInput("")
gui.setPosition(display, 20, 20)
gui.setSize(display, 250, 40)
gui.setFontSize(display, 20)

local buttons = [
    "7", "8", "9", "/",
    "4", "5", "6", "*",
    "1", "2", "3", "-",
    "C", "0", "=", "+"
]

local i = 0
local xBtn = 20
local yBtn = 70
while i < len(buttons) do
    local btn = gui.newButton(buttons[i])
    gui.setID(btn, buttons[i])
    gui.setPosition(btn, xBtn, yBtn)
    gui.setSize(btn, 58, 50)
    gui.setFontSize(btn, 18)
    gui.add(win, btn)

    xBtn = xBtn + 63
    if (i + 1) % 4 == 0 then
        xBtn = 20
        yBtn = yBtn + 55
    end
    i = i + 1
end

gui.add(win, display)

gui.showAndRun(app)