import text

function add(a, b)
    return a + b
end

function subtract(a, b)
    return a - b
end

function multiply(a, b)
    return a * b
end

function divide(a, b)
    if b == 0 then
        return null
    end
    return a / b
end

function mod(a, b)
    if b == 0 then
        return null
    end
    return a % b
end

function calculator(operation, a, b)
    if operation == "add" then
        return add(a, b)
    else
        if operation == "sub" then
            return subtract(a, b)
        else
            if operation == "mul" then
                return multiply(a, b)
            else
                if operation == "div" then
                    return divide(a, b)
                else
                    if operation == "mod" then
                        return mod(a, b)
                    else
                        return null
                    end
                end
            end
        end
    end
end

print("Calculator Demo")
print("5 + 3 =", calculator("add", 5, 3))
print("10 - 4 =", calculator("sub", 10, 4))
print("6 * 7 =", calculator("mul", 6, 7))
print("20 / 4 =", calculator("div", 20, 4))
print("15 mod 4 =", calculator("mod", 15, 4))
print("10 / 0 =", calculator("div", 10, 0))