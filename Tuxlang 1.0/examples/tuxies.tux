import tuxies
import time
import array

function add(a, b)
    return a + b
end

function pauseAndTag(label, ms)
    time.sleepMs(ms)
    return label
end

function addOne(n)
    return n + 1
end

local first = tuxies.spawn(add, 20, 22)
local second = tuxies.spawn(pauseAndTag, "quick", 1)
local third = tuxies.spawn(pauseAndTag, "later", 10)
local fourth = tuxies.spawn(pauseAndTag, "cancel me", 30)

print("sum:", tuxies.wait(first))
print("task:", tuxies.wait(second))
time.sleepMs(15)
print("status:", tuxies.status(third))
print("done?", tuxies.done(third))
print("cancel:", tuxies.cancel(fourth))
print("cancel status:", tuxies.status(fourth))
print("all:", array.join(tuxies.all([first, second, third]), ", "))
print("map:", array.join(tuxies.map([1, 2, 3], addOne), ", "))
print("group:", array.join(tuxies.group([tuxies.spawn(addOne, 1), tuxies.spawn(addOne, 2)]), ", "))
